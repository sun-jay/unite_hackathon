{
  "name": "htlc-swap",
  "version": "1.0.0",
  "description": "Cross-chain HTLC atomic swaps",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:tron": "tronbox test --network development",
    "test:tron:live": "node scripts/test-tron-live.js",
    "test:interop": "node test/interop_tests/cross-chain-happy-path-test.js",
    "test:timeout": "node test/interop_tests/cross-chain-timeout-refund-test.js",
    "test:helpers": "node test/unit/encoding-helpers.test.js",
    "config:check": "node scripts/check-config.js",
    "dev:evm": "hardhat node",
    "dev:evm:deploy": "hardhat run scripts/deploy-local.ts --network hardhat",
    "dev:tron:start": "docker-compose up -d",
    "dev:tron:stop": "docker-compose down",
    "dev:tron:deploy": "tronbox migrate --network development --reset",
    "dev:tron:logs": "docker-compose logs -f tron-quickstart",
    "dev:tron:status": "curl -s http://localhost:9090/wallet/getnowblock | jq '.block_header.raw_data.number' || echo 'Tron node not running'",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "deploy:nile": "tronbox migrate --network nile --reset",
    "check:tron": "node scripts/check-tron-address.js",
    "healthcheck": "node healthcheck.mjs",
    "check:eth": "node eth_check.mjs",
    "send:eth": "node eth_send.mjs",
    "send:tron": "node tron_send.mjs"
  },
  "keywords": ["blockchain", "htlc", "atomic-swap", "cross-chain"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.13",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.14",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@nomicfoundation/ignition-core": "^0.15.13",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": ">=9.1.0",
    "chai": "^4.2.0",
    "dotenv": "^17.2.1",
    "hardhat": "^2.22.15",
    "hardhat-gas-reporter": "^2.3.0",
    "solidity-coverage": "^0.8.1",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "tronweb": "^6.1.0"
  }
}
